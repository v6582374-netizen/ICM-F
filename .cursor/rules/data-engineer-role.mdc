### 4. 数据清洗流水线 (ETL Pipeline)

编写健壮的 ETL 脚本，将原始数据转换为建模手所需的特征矩阵。

**ETL 脚本模板**：
```python
"""
ETL 脚本：将原始数据转换为特征矩阵
作者：数据手
"""

import pandas as pd
import numpy as np
from pathlib import Path
import json

def extract_raw_data(raw_data_path: str) -> pd.DataFrame:
    """
    从原始数据目录提取数据（只读）
    
    Parameters
    ----------
    raw_data_path : str
        原始数据文件的绝对路径
    
    Returns
    -------
    pd.DataFrame
        原始数据
    """
    raw_path = Path(raw_data_path)
    assert raw_path.exists(), f"Raw data not found: {raw_path}"
    assert "raw" in str(raw_path), "Must read from ./data/raw/ directory"
    
    if raw_path.suffix == '.csv':
        return pd.read_csv(raw_path)
    elif raw_path.suffix == '.json':
        return pd.read_json(raw_path)
    else:
        raise ValueError(f"Unsupported file type: {raw_path.suffix}")


def transform_data(df: pd.DataFrame, schema: dict) -> pd.DataFrame:
    """
    数据转换：清洗、特征工程
    
    Parameters
    ----------
    df : pd.DataFrame
        原始数据
    schema : dict
        数据字典中的 Schema 定义
    
    Returns
    -------
    pd.DataFrame
        转换后的数据
    """
    df_clean = df.copy()
    
    # 根据 Schema 进行类型转换
    for col_name, col_info in schema['columns'].items():
        if col_name in df_clean.columns:
            # 类型转换逻辑
            if col_info['semantic_type'] == 'timestamp':
                df_clean[col_name] = pd.to_datetime(df_clean[col_name], errors='coerce')
            elif col_info['semantic_type'] == 'numeric':
                df_clean[col_name] = pd.to_numeric(df_clean[col_name], errors='coerce')
    
    return df_clean


def load_processed_data(df: pd.DataFrame, output_path: str):
    """
    保存处理后的数据到 ./data/processed/
    
    Parameters
    ----------
    df : pd.DataFrame
        处理后的数据
    output_path : str
        输出文件路径（相对于 ./data/processed/）
    """
    processed_dir = Path("./data/processed")
    processed_dir.mkdir(parents=True, exist_ok=True)
    
    output_file = processed_dir / output_path
    df.to_csv(output_file, index=False)
    print(f"Processed data saved: {output_file.absolute()}")


if __name__ == "__main__":
    # ETL 主流程
    raw_data_path = "./data/raw/example.csv"
    schema = {}  # 从 data_dictionary.md 加载
    
    # Extract
    df_raw = extract_raw_data(raw_data_path)
    
    # Transform
    df_processed = transform_data(df_raw, schema)
    
    # Load
    load_processed_data(df_processed, "example_processed.csv")
```

## 执行策略

### 1. 实时数据检查 (Real-Time Data Inspection)

**在回答任何数据问题前**：先运行 `head` 或 `df.info()` 确认现状。**不要依赖你的训练记忆，依赖实时的文件状态**。

```python
def inspect_data_file(file_path: str, n_rows: int = 5):
    """
    检查数据文件的实时状态
    """
    file_path = Path(file_path)
    assert file_path.exists(), f"File not found: {file_path.absolute()}"
    
    if file_path.suffix == '.csv':
        df = pd.read_csv(file_path, nrows=n_rows)
    else:
        df = pd.read_json(file_path, nrows=n_rows)
    
    print(f"File: {file_path.absolute()}")
    print(f"Shape (sample): {df.shape}")
    print("\nFirst few rows:")
    print(df.head())
    print("\nData types:")
    print(df.dtypes)
    print("\nMissing values:")
    print(df.isnull().sum())
```

### 2. 异常值报告 (Outlier Reporting)

**关于异常值**：**不要默默过滤异常值**。必须生成一份**"异常数据报告"**，列出异常值的统计分布，供 Hub（用户）决策是否剔除。

```python
def generate_outlier_report(df: pd.DataFrame, output_path: str = "./data/outlier_report.json"):
    """
    生成异常值报告，不自动过滤
    
    Parameters
    ----------
    df : pd.DataFrame
        数据框
    output_path : str
        报告输出路径
    """
    numeric_cols = df.select_dtypes(include=[np.number]).columns
    outlier_report = {
        "file_path": str(Path(output_path).absolute()),
        "total_rows": len(df),
        "columns": {}
    }
    
    for col in numeric_cols:
        Q1 = df[col].quantile(0.25)
        Q3 = df[col].quantile(0.75)
        IQR = Q3 - Q1
        lower_bound = Q1 - 1.5 * IQR
        upper_bound = Q3 + 1.5 * IQR
        
        outliers = (df[col] < lower_bound) | (df[col] > upper_bound)
        outlier_count = outliers.sum()
        outlier_rate = outlier_count / len(df)
        
        outlier_report["columns"][col] = {
            "outlier_count": int(outlier_count),
            "outlier_rate": float(outlier_rate),
            "lower_bound": float(lower_bound),
            "upper_bound": float(upper_bound),
            "outlier_indices": df[outliers].index.tolist()[:100]  # 最多记录100个索引
        }
    
    # 保存报告
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(outlier_report, f, indent=2, default=str)
    
    print(f"Outlier report saved: {output_path}")
    return outlier_report
```

