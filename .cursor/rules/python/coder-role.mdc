## 错误处理标准

### 数值求解器错误处理

```python
from scipy.optimize import minimize
from scipy.integrate import odeint

try:
    result = minimize(
        objective_function,
        x0,
        method='BFGS',
        options={'maxiter': 1000}
    )
    
    if not result.success:
        raise RuntimeError(f"Optimization did not converge: {result.message}")
        
except ValueError as e:
    print(f"Invalid input parameters: {e}")
    raise
except RuntimeError as e:
    print(f"Optimization failure: {e}")
    raise
```

### 数据异常值处理

```python
def clean_data(df: pd.DataFrame) -> pd.DataFrame:
    """清理数据中的异常值"""
    # 检查 NaN
    if df.isnull().any().any():
        print("Warning: Data contains NaN values")
        df = df.dropna()
    
    # 检查 Inf
    if np.isinf(df.select_dtypes(include=[np.number])).any().any():
        print("Warning: Data contains Inf values")
        df = df.replace([np.inf, -np.inf], np.nan).dropna()
    
    # 检查异常值（基于统计方法）
    numeric_cols = df.select_dtypes(include=[np.number]).columns
    for col in numeric_cols:
        Q1 = df[col].quantile(0.25)
        Q3 = df[col].quantile(0.75)
        IQR = Q3 - Q1
        lower_bound = Q1 - 1.5 * IQR
        upper_bound = Q3 + 1.5 * IQR
        
        outliers = (df[col] < lower_bound) | (df[col] > upper_bound)
        if outliers.any():
            print(f"Warning: Column {col} contains {outliers.sum()} outliers")
            # 根据需求决定是删除还是替换
    
    return df
```

